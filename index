<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>아이돌 착용 아이템 링크 모음</title>
</head>
<body>
  <div class="app">

    <!-- 상단 헤더: 미니멀 텍스트 + 검색 -->
    <header class="mobile-header">
      <div class="topbar">
        <button class="icon-btn" type="button" aria-label="메뉴 열기">메뉴</button>
        <h1 class="logo">FIT LINK</h1>
        <div class="top-actions">
          <button class="icon-btn" type="button" aria-label="검색 열기">검색</button>
          <button class="icon-btn" type="button" aria-label="저장한 링크">링크함</button>
        </div>
      </div>

      <div class="search-box">
        <label class="sr-only" for="search-input">아이템 검색</label>
        <input id="search-input" type="search" placeholder="아이돌, 브랜드, 아이템 검색" />
      </div>

      <div class="category-scroll">
        <button class="category-chip active" type="button">전체</button>
        <button class="category-chip" type="button">여돌</button>
        <button class="category-chip" type="button">남돌</button>
        <button class="category-chip" type="button">무대</button>
        <button class="category-chip" type="button">공항패션</button>
        <button class="category-chip" type="button">사복</button>
      </div>
    </header>

    <!-- 사이트 역할 안내 -->
    <section class="notice-section">
      <h2 class="notice-title">사이트 안내</h2>
      <p class="notice-body">
        이 사이트는 아이돌이 실제로 착용한 패션 정보를 정리해 외부 쇼핑몰로 연결해 주는
        정보·링크 모음 페이지입니다. 여기서는 직접 판매나 결제가 이루어지지 않습니다.
      </p>
    </section>

    <main class="content">

      <!-- 원하는 구조: 아이돌 착용 + 단품, 2장 슬라이드 / 신체 정보 / 외부 링크 -->
      <section class="section-head">
        <h2>아이돌 착용 아이템</h2>
        <button type="button" class="section-filter">정렬</button>
      </section>

      <section class="product-list">

        <!-- 카드 1 -->
        <article class="product-card">

          <!-- 아이돌 정보 블록 -->
          <header class="idol-header">
            <div class="idol-meta">
              <p class="idol-name">아이유</p>
              <p class="idol-group">솔로</p>
            </div>
            <dl class="idol-body-info">
              <div class="body-item">
                <dt>키</dt>
                <dd>162cm</dd>
              </div>
              <div class="body-item">
                <dt>몸무게</dt>
                <dd>44kg</dd>
              </div>
              <div class="body-item">
                <dt>착용 사이즈</dt>
                <dd>S</dd>
              </div>
            </dl>
          </header>

          <!-- 2장 슬라이드 영역 (아이돌 착용 / 단품) -->
          <div class="photo-slider" aria-label="아이돌 착용 사진과 단품 사진 슬라이드">
            <div class="slider-track">
              <!-- 슬라이드 1: 아이돌 착용 -->
              <figure class="slide is-active">
                <img
                  src="https://via.placeholder.com/400x500?text=아이돌+착용"
                  alt="아이유가 착용한 화이트 셔츠 전체 코디"
                />
                <figcaption class="slide-caption">착용 컷</figcaption>
              </figure>

              <!-- 슬라이드 2: 단품 -->
              <figure class="slide">
                <img
                  src="https://via.placeholder.com/400x500?text=단품+셔츠"
                  alt="동일 제품 화이트 셔츠 단품 사진"
                />
                <figcaption class="slide-caption">단품 사진</figcaption>
              </figure>
            </div>

            <!-- 슬라이드 컨트롤 (동작은 추후 JS로 연결) -->
            <div class="slider-controls">
              <button type="button" class="slider-prev">이전</button>
              <span class="slider-status">1 / 2</span>
              <button type="button" class="slider-next">다음</button>
            </div>
          </div>

          <!-- 아이템 정보 + 외부 링크 -->
          <div class="product-info">
            <p class="brand">MUSINSA STANDARD</p>
            <p class="name">오버핏 코튼 옥스포드 셔츠 화이트</p>
            <p class="fit-note">
              아이유 162cm / 44kg, S 사이즈 착용. 여유 있게 떨어지는 오버핏 셔츠.
            </p>

            <div class="link-block">
              <a
                class="external-link"
                href="https://example.com/product/1"
                target="_blank"
                rel="noopener noreferrer"
              >
                공식몰에서 상품 정보 보기
              </a>
              <p class="link-note">외부 쇼핑몰(공식몰)로 이동합니다. 결제는 해당 사이트에서 진행됩니다.</p>
            </div>
          </div>
        </article>

        <!-- 카드 2 -->
        <article class="product-card">

          <header class="idol-header">
            <div class="idol-meta">
              <p class="idol-name">장원영</p>
              <p class="idol-group">IVE</p>
            </div>
            <dl class="idol-body-info">
              <div class="body-item">
                <dt>키</dt>
                <dd>173cm</dd>
              </div>
              <div class="body-item">
                <dt>몸무게</dt>
                <dd>48kg</dd>
              </div>
              <div class="body-item">
                <dt>착용 사이즈</dt>
                <dd>XS</dd>
              </div>
            </dl>
          </header>

          <div class="photo-slider" aria-label="아이돌 착용 사진과 단품 사진 슬라이드">
            <div class="slider-track">
              <figure class="slide is-active">
                <img
                  src="https://via.placeholder.com/400x500?text=아이돌+착용"
                  alt="장원영 공항 패션 코디 이미지"
                />
                <figcaption class="slide-caption">착용 컷</figcaption>
              </figure>
              <figure class="slide">
                <img
                  src="https://via.placeholder.com/400x500?text=단품+코트"
                  alt="동일 제품 롱 코트 단품 사진"
                />
                <figcaption class="slide-caption">단품 사진</figcaption>
              </figure>
            </div>
            <div class="slider-controls">
              <button type="button" class="slider-prev">이전</button>
              <span class="slider-status">1 / 2</span>
              <button type="button" class="slider-next">다음</button>
            </div>
          </div>

          <div class="product-info">
            <p class="brand">ABLY PICK</p>
            <p class="name">롱 더블 코트 그레이</p>
            <p class="fit-note">
              장원영 173cm / 48kg, XS 사이즈 착용. 발목 위까지 오는 롱 기장, 슬림한 실루엣.
            </p>

            <div class="link-block">
              <a
                class="external-link"
                href="https://example.com/product/2"
                target="_blank"
                rel="noopener noreferrer"
              >
                공식몰에서 상품 정보 보기
              </a>
              <p class="link-note">외부 쇼핑몰로 연결되는 정보성 링크입니다. 이 사이트에서 결제는 진행되지 않습니다.</p>
            </div>
          </div>
        </article>

      </section>
    </main>

    <!-- 하단 내비게이션 (기존 기능 정리·축소, 텍스트 기반) -->
    <nav class="bottom-nav" aria-label="하단 내비게이션">
      <button class="nav-item is-active" type="button">
        <span class="nav-label-main">홈</span>
        <span class="nav-label-sub">피드</span>
      </button>
      <button class="nav-item" type="button">
        <span class="nav-label-main">컬렉션</span>
        <span class="nav-label-sub">테마 모음</span>
      </button>
      <button class="nav-item" type="button">
        <span class="nav-label-main">검색</span>
        <span class="nav-label-sub">필터</span>
      </button>
      <button class="nav-item" type="button">
        <span class="nav-label-main">링크함</span>
        <span class="nav-label-sub">저장</span>
      </button>
      <button class="nav-item" type="button">
        <span class="nav-label-main">마이</span>
        <span class="nav-label-sub">설정</span>
      </button>
    </nav>
  </div>
</body>
</html>
